<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keystrike observes key events, so it needs Accessibility permission;
	     that is granted by the user in System Settings, not by an entitlement.
	     No sandbox, because an event tap plus SPU HID + Core Audio output are
	     all outside the sandbox's reach. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
